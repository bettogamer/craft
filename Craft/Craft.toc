# Libraries — LibStub en su propio folder (convención estándar WoW)
libs\LibStub\LibStub.lua

# Weave v0.10.0 (vendored, READ-ONLY) — reactive signals; load order mirrors its Weave.xml
libs\Weave\Weave.lua
libs\Weave\core\Core.lua
libs\Weave\core\Reconcile.lua
libs\Weave\core\Tween.lua
libs\Weave\core\Window.lua
libs\Weave\core\Flow.lua
libs\Weave\wow\Events.lua
libs\Weave\wow\Props.lua
libs\Weave\wow\Ticker.lua
libs\Weave\wow\Anim.lua
libs\Weave\wow\Promise.lua
libs\Weave\store\Store.lua
libs\Weave\ui\Ui.lua
libs\Weave\ui\Each.lua
libs\Weave\ui\Virtual.lua

# Core — must load first; creates the Craft namespace
Craft.lua
Reactive.lua

# Theme — Presets before Theme (Theme.lua references CraftPresets global)
theme\Presets.lua
theme\Theme.lua

# Shapes — prefab rounded-shape UV descriptor (ADR-0018; consumed by Switch)
theme\Shapes.lua
# RoundedSurface — fill + 1px ring of radius r (FR-141; needs Shapes)
theme\RoundedSurface.lua

# Icons
icons\Atlas.lua
icons\Icons.lua

# Layout
layout\Flex.lua
layout\Grid.lua

# Components
